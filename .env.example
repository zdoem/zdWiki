# zdWiki v1 Environment Configuration

# Server Port & Host
ZDWIKI_HOST=0.0.0.0
ZDWIKI_PORT=8000

# Paths (Relative to repository root or absolute)
ZDWIKI_KNOWLEDGE_DIR=knowledge
ZDWIKI_DB_PATH=var/zdwiki.db
ZDWIKI_RAW_DIR=knowledge/raw

# LLM Providers (Optional for search, required for Ask zdWiki)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
